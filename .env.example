# Copy to .env and fill in. Never commit .env.
# Bot token from @BotFather in Telegram:
TELEGRAM_BOT_TOKEN=
# Where alerts are sent: your Telegram user id or a group chat id (write to the bot once first).
CHAT_ID=

# binance or bybit (public data only, no exchange keys are used)
EXCHANGE=binance
# How often to check, in seconds (minimum 15)
CHECK_SECONDS=60
# The same rule will not alert again for this many minutes
COOLDOWN_MINUTES=60
